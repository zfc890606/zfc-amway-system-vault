<view class="page">
  <view class="hero">
    <view class="hero-title">🤝 加入重养计划</view>
    <view class="hero-sub" wx:if="{{planName}}">你即将加入「{{planName}}」</view>
    <view class="hero-sub" wx:else>输入邀请码，一起坚持 180 天</view>
  </view>

  <view class="form card">
    <view class="field">
      <text class="label">邀请码</text>
      <input
        class="input code-input"
        placeholder="6 位邀请码"
        value="{{inviteCode}}"
        bindinput="onCode"
        maxlength="6"
        confirm-type="done"
        bindconfirm="onSubmit"
      />
    </view>
    <view class="field">
      <text class="label">你的昵称（看板显示）</text>
      <input class="input" placeholder="1-12 个字" value="{{nickname}}" bindinput="onNickname" maxlength="12" />
    </view>
    <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '加入中…' : '加入计划'}}
    </button>
  </view>
</view>
