/* 全局样式 */
page {
  background: #F6F4F0;
  font-size: 28rpx;
  color: #2B2B2B;
  -webkit-font-smoothing: antialiased;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #C09070;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #D8C4B2;
  color: #FFFFFF;
}

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #8A8A8A;
  margin-bottom: 8rpx;
}

.input {
  width: 100%;
  background: #F7F5F2;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  background: #F7F5F2;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  min-height: 120rpx;
}

.empty {
  text-align: center;
  color: #B0B0B0;
  padding: 120rpx 40rpx;
  font-size: 28rpx;
}
