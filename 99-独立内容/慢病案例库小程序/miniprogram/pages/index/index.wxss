.page {
  padding-bottom: 40rpx;
}

/* 搜索 */
.search-bar {
  position: relative;
  margin: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 0 24rpx;
}
.search-input {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
.search-clear {
  position: absolute;
  right: 24rpx;
  top: 0;
  height: 76rpx;
  line-height: 76rpx;
  color: #B0B0B0;
  font-size: 28rpx;
}

/* 板块 Tab */
.tabs {
  white-space: nowrap;
  padding: 8rpx 16rpx 16rpx;
}
.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin: 0 8rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #555555;
}
.tab.active {
  background: #C09070;
  color: #FFFFFF;
  font-weight: 600;
}

/* 案例卡片 */
.case-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 16rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.case-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.5;
}
.case-tags {
  margin-top: 12rpx;
}
.tag {
  display: inline-block;
  background: #F3EEE7;
  color: #8A6D4F;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.case-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.meta-right {
  color: #A0A0A0;
  font-size: 24rpx;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #C8C8C8;
}
.loading-tip {
  text-align: center;
  color: #B0B0B0;
  font-size: 26rpx;
  padding: 40rpx;
}
