.page {
  padding-bottom: 60rpx;
}

/* AI 卡片 */
.ai-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.ai-tip {
  font-size: 24rpx;
  color: #8A8A8A;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.ai-input {
  width: 100%;
  min-height: 200rpx;
  background: #F7F5F2;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}
.ai-btn {
  margin-top: 20rpx;
}
.ai-result {
  margin-top: 24rpx;
  background: #FBF7F1;
  border: 1rpx solid #EADDCB;
  border-radius: 12rpx;
  padding: 20rpx;
}
.ai-result-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8A6D4F;
  margin-bottom: 12rpx;
}
.ai-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.ai-row-label {
  flex: 0 0 80rpx;
  color: #8A8A8A;
}
.ai-row-val {
  flex: 1;
  color: #333333;
}
.tag {
  display: inline-block;
  background: #F3EEE7;
  color: #8A6D4F;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

/* 表单 */
.form-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.picker {
  line-height: 1.4;
}
.picker.placeholder {
  color: #C0C0C0;
}
.save-btn {
  margin-top: 12rpx;
}
