<view class="page">
  <view class="card overview">
    <view class="ov-item">
      <view class="ov-num">{{total}}</view>
      <view class="ov-label">案例总数</view>
    </view>
    <view class="ov-divider"></view>
    <view class="ov-item">
      <view class="ov-num">{{myCount}}</view>
      <view class="ov-label">我录入的</view>
    </view>
  </view>

  <view class="card">
    <view class="form-title">各板块案例</view>
    <view class="cat-row" wx:for="{{cats}}" wx:key="key">
      <view class="cat-left">
        <text class="cat-emoji">{{item.emoji}}</text>
        <text class="cat-name">{{item.key}}</text>
      </view>
      <view class="cat-count" style="color:{{item.color}}">{{item.count}}</view>
    </view>
    <view class="empty" wx:if="{{!loading && total === 0}}">还没有案例，去录第一条吧</view>
  </view>

  <view class="card tips">
    <view class="form-title">合规提示</view>
    <view class="tip-line">· 案例已脱敏（只存化名+年龄段），不存客户全名与联系方式</view>
    <view class="tip-line">· 内容记录为「生活方式干预复盘」，不写疗效承诺</view>
    <view class="tip-line">· 本工具仅供团队内部学习使用，不对外提供诊疗建议</view>
  </view>
</view>
