.page {
  padding-bottom: 40rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.date {
  color: #A0A0A0;
  font-size: 24rpx;
}
.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #222222;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.section {
  margin-bottom: 28rpx;
}
.section-label {
  font-size: 24rpx;
  color: #A0A0A0;
  margin-bottom: 8rpx;
  font-weight: 600;
}
.section-val {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  white-space: pre-wrap;
}
.tag {
  display: inline-block;
  background: #F3EEE7;
  color: #8A6D4F;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.btn-primary {
  flex: 1;
  background: #C09070;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-primary::after {
  border: none;
}
.btn-ghost {
  flex: 1;
  background: #FFFFFF;
  color: #8A8A8A;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: 1rpx solid #DDDDDD;
}
.btn-ghost::after {
  border: none;
}
.btn-danger {
  flex: 1;
  background: #FFFFFF;
  color: #E74C3C;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: 1rpx solid #F2C4C0;
}
.btn-danger::after {
  border: none;
}

.form-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.field {
  margin-bottom: 24rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #8A8A8A;
  margin-bottom: 8rpx;
}
.input {
  width: 100%;
  background: #F7F5F2;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}
.textarea {
  width: 100%;
  background: #F7F5F2;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  min-height: 120rpx;
}
