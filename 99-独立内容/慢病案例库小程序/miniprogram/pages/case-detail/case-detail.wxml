<view class="page" wx:if="{{caseData}}">
  <view class="card">
    <!-- 查看模式 -->
    <block wx:if="{{!editing}}">
      <view class="head">
        <text class="badge" style="background:{{color}}">{{caseData.category}}</text>
        <text class="date">更新于 {{updatedAtText}}</text>
      </view>
      <view class="title">{{caseData.title}}</view>

      <view class="section" wx:if="{{caseData.alias || caseData.ageRange}}">
        <view class="section-label">客户</view>
        <view class="section-val">{{caseData.alias || '—'}} <text wx:if="{{caseData.ageRange}}">· {{caseData.ageRange}}</text></view>
      </view>

      <view class="section" wx:if="{{caseData.chiefComplaint}}">
        <view class="section-label">主诉 / 背景</view>
        <view class="section-val">{{caseData.chiefComplaint}}</view>
      </view>

      <view class="section" wx:if="{{caseData.metrics}}">
        <view class="section-label">检查指标</view>
        <view class="section-val">{{caseData.metrics}}</view>
      </view>

      <view class="section" wx:if="{{caseData.plan}}">
        <view class="section-label">调理方案</view>
        <view class="section-val">{{caseData.plan}}</view>
      </view>

      <view class="section" wx:if="{{caseData.result}}">
        <view class="section-label">结果复盘</view>
        <view class="section-val">{{caseData.result}}</view>
      </view>

      <view class="section" wx:if="{{caseData.tags.length}}">
        <view class="section-label">标签</view>
        <view class="section-val">
          <text class="tag" wx:for="{{caseData.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="actions">
        <button class="btn-ghost" bindtap="onEdit">✏️ 编辑</button>
        <button class="btn-danger" bindtap="onDelete">🗑 删除</button>
      </view>
    </block>

    <!-- 编辑模式 -->
    <block wx:else>
      <view class="form-title">编辑案例</view>
      <view class="field">
        <text class="label">标题</text>
        <input class="input" value="{{form.title}}" bindinput="onField" data-field="title" />
      </view>
      <view class="field">
        <text class="label">板块</text>
        <picker range="{{categories}}" bindchange="onCategory">
          <view class="input">{{form.category}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">化名</text>
        <input class="input" value="{{form.alias}}" bindinput="onField" data-field="alias" />
      </view>
      <view class="field">
        <text class="label">年龄段</text>
        <input class="input" value="{{form.ageRange}}" bindinput="onField" data-field="ageRange" />
      </view>
      <view class="field">
        <text class="label">主诉 / 背景</text>
        <textarea class="textarea" value="{{form.chiefComplaint}}" bindinput="onField" data-field="chiefComplaint" />
      </view>
      <view class="field">
        <text class="label">检查指标</text>
        <textarea class="textarea" value="{{form.metrics}}" bindinput="onField" data-field="metrics" />
      </view>
      <view class="field">
        <text class="label">调理方案</text>
        <textarea class="textarea" value="{{form.plan}}" bindinput="onField" data-field="plan" />
      </view>
      <view class="field">
        <text class="label">结果复盘</text>
        <textarea class="textarea" value="{{form.result}}" bindinput="onField" data-field="result" />
      </view>
      <view class="actions">
        <button class="btn-primary" bindtap="onSave">保存</button>
        <button class="btn-ghost" bindtap="onCancelEdit">取消</button>
      </view>
    </block>
  </view>
</view>
