<view class="page">
  <view class="hero">
    <view class="hero-title">🌱 180天重养计划</view>
    <view class="hero-sub">把自己重新养一遍，和伙伴一起坚持</view>
  </view>

  <view class="form card">
    <view class="field">
      <text class="label">计划名称</text>
      <input class="input" placeholder="例如：2026 秋季重养计划" value="{{name}}" bindinput="onName" maxlength="20" />
    </view>
    <view class="field">
      <text class="label">开始日期</text>
      <picker mode="date" value="{{startDate}}" bindchange="onStartDate">
        <view class="input picker-value">{{startDate}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">你的昵称（看板显示）</text>
      <input class="input" placeholder="1-12 个字" value="{{nickname}}" bindinput="onNickname" maxlength="12" />
    </view>
    <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '创建中…' : '创建计划，生成邀请码'}}
    </button>
    <view class="hint">创建后你会自动成为第一位成员，伙伴凭邀请码加入。</view>
  </view>
</view>
